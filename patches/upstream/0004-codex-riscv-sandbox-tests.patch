@@ -0,0 +1,119 @@
+// Test-only V8 intrinsics are enabled ONLY in the separate Rust test process.
+// They are never enabled by the shipping Code Mode host.
+(() => {
+  const check = (condition, label) => { if (!condition) throw new Error(label); };
+  const bytes = new Uint8Array(nativeBuffer);
+  const view = new DataView(nativeBuffer);
+  for (let i = 0; i < bytes.length; i++) {
+    check(view.getUint8(i) === (i ^ 0x5a), `native to JS ${i}`);
+    view.setUint8(i, (i * 17 + 3) & 255);
+  }
+  const copied = new Uint8Array(nativeBuffer.slice(8, 40));
+  check(copied.every((v, i) => v === (((i + 8) * 17 + 3) & 255)), 'ArrayBuffer.slice');
+  const sliced = bytes.slice(16, 48);
+  check(sliced.every((v, i) => v === (((i + 16) * 17 + 3) & 255)), 'Uint8Array.slice');
+
+  // Native-provided bytes and native verification of writes prevent paired
+  // incorrect read/write address calculations from cancelling each other.
+  const nativeUint32 = new Uint32Array(nativeTypedBuffer, 8, 2);
+  const nativeFloat64 = new Float64Array(nativeTypedBuffer, 24, 1);
+  const nativeBigInt64 = new BigInt64Array(nativeTypedBuffer, 40, 1);
+  check(nativeUint32[0] === 0x3e39342f, 'native Uint32 nonzero byteOffset');
+  check(nativeFloat64[0] === -123.5, 'native Float64 nonzero byteOffset');
+  check(nativeBigInt64[0] === -123456789012345n, 'native BigInt64 nonzero byteOffset');
+  nativeUint32[0] = 0x89abcdef;
+  nativeFloat64[0] = 1.25;
+  nativeBigInt64[0] = -0x1234567890abcdn;
+
+  const cases = [
+    ['Int8', -91], ['Uint8', 213], ['Int16', -12345], ['Uint16', 54321],
+    ['Int32', -123456789], ['Uint32', 3456789012], ['Float16', 1.25], ['Float32', 1.25],
+    ['Float64', -123.125], ['BigInt64', -123456789012345n],
+    ['BigUint64', 12345678901234567890n],
+  ];
+  for (const [kind, value] of cases) {
+    const dv = new DataView(new ArrayBuffer(64));
+    for (const littleEndian of [false, true]) {
+      dv[`set${kind}`](3, value, littleEndian);
+      check(dv[`get${kind}`](3, littleEndian) === value, `DataView ${kind}`);
+    }
+    let rejected = false;
+    try { dv[`get${kind}`](64); } catch (error) { rejected = error instanceof RangeError; }
+    check(rejected, `DataView bounds ${kind}`);
+  }
+
+  const constructors = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array,
+    Uint16Array, Int32Array, Uint32Array, Float16Array, Float32Array, Float64Array,
+    BigInt64Array, BigUint64Array];
+  for (const C of constructors) {
+    const big = C === BigInt64Array || C === BigUint64Array;
+    const value = n => big ? BigInt(n) : n;
+    const a = new C([1, 2, 3, 4].map(value));
+    a.set(a.subarray(0, 3), 1);
+    check([...a].every((v, i) => v === value([1, 1, 2, 3][i])), `overlap set ${C.name}`);
+    const b = a.slice();
+    b.copyWithin(0, 2);
+    check(b[0] === value(2) && b[1] === value(3), `copyWithin ${C.name}`);
+    const roundtrip = (arr, index, v) => { arr[index] = v; return arr[index]; };
+    %PrepareFunctionForOptimization(roundtrip);
+    for (let i = 0; i < 100; i++) check(roundtrip(a, i & 3, value(i & 7)) === value(i & 7), C.name);
+    %OptimizeFunctionOnNextCall(roundtrip);
+    check(roundtrip(a, 1, value(7)) === value(7), `optimized ${C.name}`);
+    // Pinned V8 runtime.h OptimizationStatus: kOptimized=1<<3, kTurboFanned=1<<5.
+    const status = %GetOptimizationStatus(roundtrip);
+    check((status & 8) !== 0 && (status & 32) !== 0, `TurboFan ${C.name}: ${status}`);
+    check(roundtrip(a, a.length, value(4)) === undefined, `typed bounds ${C.name}`);
+  }
+
+  const atomicTypes = [Int8Array, Uint8Array, Int16Array, Uint16Array,
+    Int32Array, Uint32Array, BigInt64Array, BigUint64Array];
+  for (const C of atomicTypes) {
+    const big = C === BigInt64Array || C === BigUint64Array;
+    const n = value => big ? BigInt(value) : value;
+    const a = new C(new SharedArrayBuffer(64));
+    Atomics.store(a, 1, n(12));
+    check(Atomics.add(a, 1, n(3)) === n(12), `Atomics.add ${C.name}`);
+    check(Atomics.compareExchange(a, 1, n(15), n(7)) === n(15), `Atomics.CAS ${C.name}`);
+    check(Atomics.load(a, 1) === n(7), `Atomics.load ${C.name}`);
+    check(Atomics.exchange(a, 1, n(9)) === n(7), `Atomics.exchange ${C.name}`);
+    check(Atomics.and(a, 1, n(3)) === n(9), `Atomics.and ${C.name}`);
+    check(Atomics.or(a, 1, n(4)) === n(1), `Atomics.or ${C.name}`);
+    check(Atomics.xor(a, 1, n(1)) === n(5), `Atomics.xor ${C.name}`);
+  }
+
+  // Pinned default sandbox allocator has an at-most8GiB PROT_NONE pool.
+  // This fixed-length request cannot fit and fails before committing data
+  // pages. Do not add RAB/maxByteLength options: those use another path.
+  let fixedPoolFailure = false;
+  try { new ArrayBuffer((8 * 1024 ** 3) + 1); }
+  catch (error) { fixedPoolFailure = error instanceof RangeError; }
+  check(fixedPoolFailure, 'fixed ArrayBuffer pool failure must be a RangeError');
+
+  const rab = new ArrayBuffer(16, { maxByteLength: 64 });
+  const tracking = new Uint8Array(rab);
+  tracking[0] = 42;
+  rab.resize(32);
+  check(tracking.length === 32 && tracking[0] === 42, 'RAB grow');
+  const fixed = new DataView(rab, 0, 16);
+  rab.resize(8);
+  let rejected = false;
+  try { fixed.getUint8(0); } catch (error) { rejected = error instanceof TypeError; }
+  check(rejected && tracking.length === 8, 'RAB shrink');
+  const gsab = new SharedArrayBuffer(16, { maxByteLength: 64 });
+  const sharedTracking = new Int32Array(gsab);
+  gsab.grow(32);
+  Atomics.store(sharedTracking, 7, 99);
+  check(sharedTracking.length === 8 && Atomics.load(sharedTracking, 7) === 99, 'GSAB grow');
+
+  const nativeRead = index => new DataView(nativeBuffer).getUint8(index);
+  %PrepareFunctionForOptimization(nativeRead);
+  for (let i = 0; i < 100; i++) check(nativeRead(i) === ((i * 17 + 3) & 255), 'native DataView warmup');
+  %OptimizeFunctionOnNextCall(nativeRead);
+  check(nativeRead(201) === ((201 * 17 + 3) & 255), 'native DataView optimized');
+  let nativeStatus = %GetOptimizationStatus(nativeRead);
+  check((nativeStatus & 8) !== 0 && (nativeStatus & 32) !== 0, 'DataView TurboFan');
+  check(nativeRead(203) === ((203 * 17 + 3) & 255), 'native DataView remains optimized');
+  nativeStatus = %GetOptimizationStatus(nativeRead);
+  check((nativeStatus & 8) !== 0 && (nativeStatus & 32) !== 0, 'DataView remains TurboFan');
+  return 'sandbox-array-roundtrip-ok';
+})();
