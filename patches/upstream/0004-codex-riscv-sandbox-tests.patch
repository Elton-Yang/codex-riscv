+//! Packaging regression probes, not an exploit-resistance certification.
+#![cfg(all(target_arch = "riscv64", target_os = "linux", target_env = "gnu"))]
+
+use codex_code_mode_runtime::V8JitMode;
+use codex_code_mode_runtime::initialize_v8;
+use std::ffi::c_char;
+use std::ffi::c_int;
+use std::io::Write;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+static PREINIT_LOW_SMI_MAPPING: AtomicUsize = AtomicUsize::new(0);
+
+// Test-only GNU ELF preinitialization. PartitionAlloc reserves its zero segment
+// before Rust main, so a later collision attempt would only test setup EEXIST.
+// GNU ld.so passes argc/argv/envp to .preinit_array before normal initializers.
+// This callback uses no allocator, TLS, Rust I/O, libc call, or mutable guard.
+#[used]
+#[unsafe(link_section = ".preinit_array")]
+static LOW_SMI_PREINIT: unsafe extern "C" fn(c_int, *const *const c_char, *const *const c_char) =
+    reserve_low_smi_before_allocators;
+
+unsafe fn raw_syscall(number: usize, arguments: [usize; 6]) -> usize {
+    let mut result = arguments[0];
+    // SAFETY: Linux RV64 syscall ABI. No stack access in the assembly; memory
+    // effects are intentionally not marked nomem, and no library is called.
+    unsafe {
+        std::arch::asm!(
+            "ecall",
+            in("a7") number,
+            inlateout("a0") result,
+            in("a1") arguments[1],
+            in("a2") arguments[2],
+            in("a3") arguments[3],
+            in("a4") arguments[4],
+            in("a5") arguments[5],
+            options(nostack),
+        );
+    }
+    result
+}
+
+unsafe extern "C" fn reserve_low_smi_before_allocators(
+    _argc: c_int,
+    _argv: *const *const c_char,
+    environment: *const *const c_char,
+) {
+    let flag = b"CODEX_TEST_RESERVE_LOW_SMI=1\0";
+    let mut cursor = environment;
+    // SAFETY: GNU loader supplies a valid null-terminated environment vector.
+    // Every string comparison stops at the first differing byte, including a
+    // premature NUL. The exact test flag is the only activating condition.
+    unsafe {
+        while !cursor.is_null() && !(*cursor).is_null() {
+            let value = *cursor as *const u8;
+            let mut index = 0;
+            while index < flag.len() && *value.add(index) == *flag.as_ptr().add(index) {
+                index += 1;
+            }
+            if index == flag.len() {
+                // RV64 __NR_mmap=222; READ|WRITE; PRIVATE|ANONYMOUS|
+                // FIXED_NOREPLACE. Never overwrite/unmap an existing guard.
+                let mapped = raw_syscall(222, [1 << 30, 4096, 3, 2 | 32 | 0x100000, usize::MAX, 0]);
+                PREINIT_LOW_SMI_MAPPING.store(mapped, Ordering::Relaxed);
+                let message: &[u8] = if mapped == 1 << 30 {
+                    b"TEST_PREINIT_LOW_SMI_MAPPED=0x40000000\n"
+                } else {
+                    b"TEST_PREINIT_LOW_SMI_RESERVATION_FAILED\n"
+                };
+                // RV64 __NR_write=64; diagnostic stderr only, no formatting.
+                let _ = raw_syscall(64, [2, message.as_ptr() as usize, message.len(), 0, 0, 0]);
+                return;
+            }
+            cursor = cursor.add(1);
+        }
+    }
+}
+
+unsafe extern "C" {
+    // Pinned rusty_v8's own native sandbox-enabled test binding.
+    fn v8__V8__IsSandboxEnabled() -> bool;
+    // Test-only access to public static V8 APIs using their Linux Itanium ABI.
+    // Verify these exact symbols against the pinned archive before running.
+    #[link_name = "_ZN2v82V814GetSandboxModeEv"]
+    fn sandbox_mode() -> u8;
+    #[link_name = "_ZN2v82V821GetSandboxSizeInBytesEv"]
+    fn sandbox_size() -> usize;
+    #[link_name = "_ZN2v82V832GetSandboxReservationSizeInBytesEv"]
+    fn sandbox_reservation_size() -> usize;
+}
+
+#[test]
+fn secure_sandbox_native_backing_store_and_optimized_arrays() {
+    // SAFETY: the pinned binding takes no pointers and returns compile-time
+    // configuration. Upstream uses this same query in test_sandbox_on.
+    assert!(unsafe { v8__V8__IsSandboxEnabled() });
+    if std::env::var_os("CODEX_TEST_RESERVE_LOW_SMI").is_some() {
+        let mapped = PREINIT_LOW_SMI_MAPPING.load(Ordering::Relaxed);
+        assert_eq!(
+            mapped,
+            1 << 30,
+            "reserve negative-test page before allocators"
+        );
+        println!("TEST_FORCED_LOW_SMI_MAPPING={mapped:#x}; initialization must fail closed");
+        std::io::stdout()
+            .flush()
+            .expect("flush negative-test marker");
+    }
+    // Only this separate test process exposes V8 testing intrinsics. The host
+    // itself never enables them; they make optimized-path coverage explicit.
+    v8::V8::set_flags_from_string("--allow-natives-syntax");
+    initialize_v8(V8JitMode::Enabled).expect("initialize sandbox-enabled V8");
+    // SAFETY: V8 has initialized; these pinned public static APIs take no
+    // pointers and return an enum with uint8_t representation / size_t values.
+    let (mode, size, reservation) =
+        unsafe { (sandbox_mode(), sandbox_size(), sandbox_reservation_size()) };
+    assert_eq!(
+        mode, 0,
+        "require full reservation AND inaccessible Smi range"
+    );
+    assert_eq!(size, 32usize << 30);
+    assert_eq!(reservation, 160usize << 30);
+    println!("sandbox_mode={mode}, sandbox_bytes={size}, reservation_bytes={reservation}");
+    println!(
+        "V8_MAPS_BEGIN\n{}V8_MAPS_END",
+        std::fs::read_to_string("/proc/self/maps").expect("read test-process maps")
+    );
+
+    let isolate = &mut v8::Isolate::new(Default::default());
+    let backing = v8::ArrayBuffer::new_backing_store(isolate, 256).make_shared();
+    for (index, cell) in backing.iter().enumerate() {
+        cell.set((index as u8) ^ 0x5a);
+    }
+    let typed_backing = v8::ArrayBuffer::new_backing_store(isolate, 64).make_shared();
+    let mut typed_expected = std::array::from_fn::<_, 64, _>(|index| (index * 5 + 7) as u8);
+    typed_expected[24..32].copy_from_slice(&(-123.5f64).to_le_bytes());
+    typed_expected[40..48].copy_from_slice(&(-123_456_789_012_345i64).to_le_bytes());
+    for (cell, expected) in typed_backing.iter().zip(typed_expected) {
+        cell.set(expected);
+    }
+    {
+        v8::scope!(let scope, isolate);
+        let context = v8::Context::new(scope, Default::default());
+        let scope = &mut v8::ContextScope::new(scope, context);
+        let buffer = v8::ArrayBuffer::with_backing_store(scope, &backing);
+        let key = v8::String::new(scope, "nativeBuffer").expect("buffer key");
+        context
+            .global(scope)
+            .set(scope, key.into(), buffer.into())
+            .expect("expose test buffer");
+        let buffer = v8::ArrayBuffer::with_backing_store(scope, &typed_backing);
+        let key = v8::String::new(scope, "nativeTypedBuffer").expect("typed buffer key");
+        context
+            .global(scope)
+            .set(scope, key.into(), buffer.into())
+            .expect("expose typed test buffer");
+        let source = v8::String::new(scope, include_str!("fixtures/riscv_sandbox_roundtrip.js"))
+            .expect("test source");
+        v8::tc_scope!(let scope, scope);
+        let script = v8::Script::compile(scope, source, None).unwrap_or_else(|| {
+            let exception = scope
+                .exception()
+                .map(|value| value.to_rust_string_lossy(scope))
+                .unwrap_or_else(|| "no JavaScript exception".to_owned());
+            panic!("compile regression suite: {exception}");
+        });
+        let result = script.run(scope).unwrap_or_else(|| {
+            let exception = scope
+                .exception()
+                .map(|value| value.to_rust_string_lossy(scope))
+                .unwrap_or_else(|| "no JavaScript exception".to_owned());
+            panic!("run regression suite: {exception}");
+        });
+        assert_eq!(
+            result
+                .to_string(scope)
+                .expect("test result")
+                .to_rust_string_lossy(scope),
+            "sandbox-array-roundtrip-ok"
+        );
+    }
+    for (index, cell) in backing.iter().enumerate() {
+        assert_eq!(
+            cell.get(),
+            ((index * 17 + 3) & 255) as u8,
+            "JS to native byte {index}"
+        );
+    }
+    typed_expected[8..12].copy_from_slice(&0x89abcdefu32.to_le_bytes());
+    typed_expected[24..32].copy_from_slice(&1.25f64.to_le_bytes());
+    typed_expected[40..48].copy_from_slice(&(-0x1234567890abcdi64).to_le_bytes());
+    for (index, (cell, expected)) in typed_backing.iter().zip(typed_expected).enumerate() {
+        assert_eq!(
+            cell.get(),
+            expected,
+            "nonzero-offset typed JS to native byte {index}"
+        );
+    }
+}
