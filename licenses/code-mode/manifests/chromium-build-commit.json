      "changes": 2,
      "blob_url": "https://github.com/denoland/chromium_build/blob/2c779f961da7f5632d6836113112179e67938868/config%2Fc%2B%2B%2FBUILD.gn",
      "raw_url": "https://github.com/denoland/chromium_build/raw/2c779f961da7f5632d6836113112179e67938868/config%2Fc%2B%2B%2FBUILD.gn",
      "contents_url": "https://api.github.com/repos/denoland/chromium_build/contents/config%2Fc%2B%2B%2FBUILD.gn?ref=2c779f961da7f5632d6836113112179e67938868",
      "patch": "@@ -23,7 +23,7 @@ config(\"runtime_library\") {\n   # V8's bundled libc++ gates its ctype rune table on __GLIBC__, which\n   # musl doesn't define; use libc++'s portable default rune table and\n   # flag musl for the remaining locale differences. Target only.\n-  if (use_musl && !toolchain_for_rust_host_build_tools) {\n+  if (use_musl && current_toolchain == default_toolchain) {\n     defines += [\n       \"_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE\",\n       \"_LIBCPP_HAS_MUSL_LIBC\","
    },
    {
      "sha": "7c2781d66d8bb2398932acd0379e5769b3a92632",
      "filename": "config/rust.gni",
      "status": "modified",
      "additions": 4,
      "deletions": 3,
      "changes": 7,
      "blob_url": "https://github.com/denoland/chromium_build/blob/2c779f961da7f5632d6836113112179e67938868/config%2Frust.gni",
      "raw_url": "https://github.com/denoland/chromium_build/raw/2c779f961da7f5632d6836113112179e67938868/config%2Frust.gni",
      "contents_url": "https://api.github.com/repos/denoland/chromium_build/contents/config%2Frust.gni?ref=2c779f961da7f5632d6836113112179e67938868",
      "patch": "@@ -345,10 +345,11 @@ if (is_linux || is_chromeos) {\n \n # When targeting musl, rewrite the gnu triple to its musl counterpart\n # (x86_64-unknown-linux-gnu -> x86_64-unknown-linux-musl, etc.) so V8's\n-# internal Rust crates + libstd are built for musl. The host build-tools\n-# toolchain must stay glibc, so exclude it.\n+# internal Rust crates + libstd are built for musl. Only the default (target)\n+# toolchain is musl; host and snapshot toolchains (which build executable build\n+# tools that run on the glibc build host) stay glibc.\n if (use_musl && rust_abi_target != \"\" &&\n-    !toolchain_for_rust_host_build_tools) {\n+    current_toolchain == default_toolchain) {\n   rust_abi_target = string_replace(rust_abi_target, \"-gnu\", \"-musl\")\n }\n "
    },
    {
      "sha": "b8d97a93251ba65a44175645d2bbc73c0cc3288c",
      "filename": "config/sysroot.gni",
      "status": "modified",
      "additions": 1,
      "deletions": 1,
      "changes": 2,
      "blob_url": "https://github.com/denoland/chromium_build/blob/2c779f961da7f5632d6836113112179e67938868/config%2Fsysroot.gni",
      "raw_url": "https://github.com/denoland/chromium_build/raw/2c779f961da7f5632d6836113112179e67938868/config%2Fsysroot.gni",
      "contents_url": "https://api.github.com/repos/denoland/chromium_build/contents/config%2Fsysroot.gni?ref=2c779f961da7f5632d6836113112179e67938868",
      "patch": "@@ -24,7 +24,7 @@ declare_args() {\n if (sysroot == \"\") {\n   if (current_os == target_os && current_cpu == target_cpu &&\n       target_sysroot != \"\" && use_musl &&\n-      !toolchain_for_rust_host_build_tools) {\n+      current_toolchain == default_toolchain) {\n     sysroot = target_sysroot\n   } else if (is_android) {\n     import(\"//build/config/android/config.gni\")"
    }
  ]
